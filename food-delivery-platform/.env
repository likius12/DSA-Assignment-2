
# Food Delivery Platform  Environment Config


# --- Kafka ---
KAFKA_BROKER=kafka:9092
KAFKA_BROKER_EXTERNAL=localhost:29092

# --- MongoDB ---
MONGO_URI=mongodb://mongodb:27017
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=admin123

# --- Service Ports (host side) ---
CUSTOMER_SERVICE_PORT=8081
RESTAURANT_SERVICE_PORT=8082
ORDER_SERVICE_PORT=8083
PAYMENT_SERVICE_PORT=8084
DELIVERY_SERVICE_PORT=8085
NOTIFICATION_SERVICE_PORT=8086
ADMIN_SERVICE_PORT=8087

# --- UI Tools ---
KAFKA_UI_PORT=8080
MONGO_EXPRESS_PORT=8081

# --- Kafka Cluster ---
KAFKA_BROKER_ID=1
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181